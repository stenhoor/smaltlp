{
  "name": "@smaltworks/smaltlp",
  "version": "0.14.0",
  "description": "Linear and mixed-integer programming for the smalt family, in TypeScript.",
  "keywords": [
    "linear-programming",
    "optimization",
    "simplex",
    "mip",
    "browser",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stenhoor/smaltlp.git"
  },
  "homepage": "https://stenhoor.github.io/smaltlp/",
  "scripts": {
    "typecheck": "node node_modules/typescript7/bin/tsc -p tsconfig.json --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "check": "npm run typecheck && npm test",
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "compare": "python3 compare/run.py",
    "test:browser": "node test/browser/docs.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "bench": "npm run build && node bench/smaltlp.mjs",
    "bench:python": "python3 bench/reference.py",
    "bench:report": "node bench/report.mjs",
    "bench:warm": "npm run build && node bench/warm.mjs",
    "bench:hard": "npm run build && node bench/hard.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lp": {
      "types": "./dist/lp/index.d.ts",
      "default": "./dist/lp/index.js"
    },
    "./mip": {
      "types": "./dist/mip/index.d.ts",
      "default": "./dist/mip/index.js"
    },
    "./model": {
      "types": "./dist/model/index.d.ts",
      "default": "./dist/model/index.js"
    },
    "./io": {
      "types": "./dist/io/index.d.ts",
      "default": "./dist/io/index.js"
    },
    "./tables": {
      "types": "./dist/tables/index.d.ts",
      "default": "./dist/tables/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "default": "./dist/worker/index.js"
    },
    "./worker-script": "./dist/worker/worker.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "1.64.1",
    "smaltkit": "github:stenhoor/smaltkit#dec0f7e08d1cb3649126b355c921a7f48b88edd9",
    "smaltty": "github:stenhoor/smaltty#v0.15.0",
    "typescript": "~6.0.3",
    "typescript7": "npm:typescript@~7.0.2",
    "vitepress": "1.6.4"
  }
}
