{
  "name": "@smaltworks/smaltlp",
  "version": "0.14.0",
  "description": "Linear and mixed-integer programming for the smalt family, in TypeScript.",
  "keywords": [
    "linear-programming",
    "optimization",
    "simplex",
    "mip",
    "browser",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stenhoor/smaltlp.git"
  },
  "homepage": "https://github.com/stenhoor/smaltlp#readme",
  "scripts": {
    "typecheck": "node node_modules/typescript7/bin/tsc -p tsconfig.json --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "check": "npm run typecheck && npm test",
    "build": "node scripts/build.mjs",
    "prepare": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lp": {
      "types": "./dist/lp/index.d.ts",
      "default": "./dist/lp/index.js"
    },
    "./model": {
      "types": "./dist/model/index.d.ts",
      "default": "./dist/model/index.js"
    },
    "./io": {
      "types": "./dist/io/index.d.ts",
      "default": "./dist/io/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3",
    "typescript7": "npm:typescript@~7.0.2"
  }
}
